; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="浪费时间之旅Ⅲ（2D俯视角ARPG）"
run/main_scene="uid://r204vgses63h"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/show_image=false
config/icon="uid://dlp3hqflfsx1v"

[autoload]

AudioManager="*res://global/global_audio_manager.gd"
LevelManager="*res://global/global_level_manager.gd"
PlayerHud="*res://scenes/gui/player_HUD/player_hud.tscn"
PlayerManager="*res://global/global_player_manager.gd"
SceneTransition="*res://scenes/gui/scene_transition/scene_transition.tscn"
SaveManager="*res://global/global_save_manager.gd"
PauseMenu="*res://scenes/gui/pause_menu/pause_menu.tscn"
DialogSystem="*res://scenes/gui/dialog_system/dialog_system.tscn"
QuestManager="*res://quests/scripts/global_quest_manager.gd"
EffectManager="*res://global/global_effect_manager.gd"
ShopMenu="*res://scenes/gui/shop_menu/shop_menu.tscn"
SignHud="*res://scenes/gui/sign_hud/sign_hud.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="2D俯视角ARPG"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://scenes/": "green"
}

[global_group]

tilemaps="有脚步声属性的瓦片地图"

[gui]

theme/custom_font="uid://dhck3ihptxe7l"

