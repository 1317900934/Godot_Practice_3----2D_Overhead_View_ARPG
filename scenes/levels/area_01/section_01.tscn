[node name="Dalog_Text" type="Node" parent="NPCs/Old_Bro/Dialog_Interact"]
script = ExtResource("13_kewy1")
text = "老铁，杵在这干*毛呢！
莫非这里有什么[shake][color=#ff5500]稀世珍宝[/color][/shake]？"
npc_info = ExtResource("14_obd8e")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dalog_Text2" type="Node" parent="NPCs/Old_Bro/Dialog_Interact"]
script = ExtResource("13_kewy1")
text = "那必须的啊老弟，告诉你个秘密，
[color=red][wave]苹果[/wave][/color]是个好东西，
多捡点，以备不时之需！"
npc_info = ExtResource("10_00lga")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dalog_Text3" type="Node" parent="NPCs/Old_Bro/Dialog_Interact"]
script = ExtResource("13_kewy1")
text = "就这？苹果能卖几个钱？"
npc_info = ExtResource("14_obd8e")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dalog_Text4" type="Node" parent="NPCs/Old_Bro/Dialog_Interact"]
script = ExtResource("13_kewy1")
text = "庸俗！等你饿得连shit都没得吃的时候，
就知道苹果多珍贵了！"
npc_info = ExtResource("10_00lga")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

