[node name="Dialog_Text" type="Node" parent="NPCs/Young_Bro/Quest_Activated_Switch/Dialog_Interact/Dialog_Choice/Dialog_Branch"]
script = ExtResource("13_kewy1")
text = "没问题，你在哪丢的？"
npc_info = ExtResource("14_obd8e")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dialog_Text2" type="Node" parent="NPCs/Young_Bro/Quest_Activated_Switch/Dialog_Interact/Dialog_Choice/Dialog_Branch"]
script = ExtResource("13_kewy1")
text = "太好了！感激不尽！
我应该是在右边的 [color=#0a2052][i]洞穴[/i][/color] 探险时丢到里面了！
之前在那里面看到个[color=#a101b7][shake]老巫师[/shake][/color]，吓得我魂飞魄散，
连滚带爬地逃了出来..."
npc_info = ExtResource("15_1cdar")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dialog_Text3" type="Node" parent="NPCs/Young_Bro/Quest_Activated_Switch/Dialog_Interact/Dialog_Choice/Dialog_Branch"]
script = ExtResource("13_kewy1")
text = "一个老东西能有多可怕？
等我一会就去会会他！"
npc_info = ExtResource("14_obd8e")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dialog_Text5" type="Node" parent="NPCs/Young_Bro/Quest_Activated_Switch/Dialog_Interact/Dialog_Choice/Dialog_Branch"]
script = ExtResource("13_kewy1")
text = "那就先多谢大哥了！
不过大哥最好先磨炼一下自己，
那个[color=#a101b7][shake]老巫师[/shake][/color]可不太好对付！
"
npc_info = ExtResource("15_1cdar")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dialog_Text6" type="Node" parent="NPCs/Young_Bro/Quest_Activated_Switch/Dialog_Interact/Dialog_Choice/Dialog_Branch"]
script = ExtResource("13_kewy1")
text = "另外，以防你遭遇不测，
接下来你可以去拿一些我珍藏多年的[color=#ff0000]宝贝[/color]！
就在穿过最下面那条[color=#0055ff]河[/color]之后的地方！
"
npc_info = ExtResource("15_1cdar")
metadata/_custom_type_script = "uid://cqdnfbqkrusmx"

[node name="Dialog_Branch2" type="Node" parent="NPCs/Young_Bro/Quest_Activated_Switch/Dialog_Interact/Dialog_Choice"]
