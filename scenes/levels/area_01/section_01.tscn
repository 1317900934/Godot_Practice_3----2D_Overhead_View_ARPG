[sub_resource type="GDScript" id="GDScript_d3bhw"]
script/source = "extends Node



@onready var quest_advance_trigger: Quest_Advance_Trigger = $\"..\"



func _ready() -> void:
	quest_advance_trigger.advanced.connect(_remove_flute)



func _remove_flute():
	PlayerManager.INVENTORY_DATA.remove_item(load(\"res://items/magical_flute.tres\"), 1)
"

